digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.28; ranksep=0.65;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  STO [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>storage</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">raw immutable · processing re-runnable</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Parquet</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">raw signals · read-only after write</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">TimescaleDB</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">power_samples hypertable + events</FONT></TD></TR><TR><TD PORT="c" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">manifest</FONT></TD><TD PORT="c_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">fw SHA · hw hash · calib capacity</FONT></TD></TR></TABLE>>];
  PROC [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>processing</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">all re-runnable, never overwrites raw</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">ecg_quality</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">0.5–40 Hz noise floor µVrms · baseline drift</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">hrv</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">NeuroKit2 · R peaks · SDNN / RMSSD</FONT></TD></TR><TR><TD PORT="c" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">energy</FONT></TD><TD PORT="c_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">EAR / RES / autonomy</FONT></TD></TR><TR><TD PORT="d" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">agreement</FONT></TD><TD PORT="d_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Bland-Altman: DUT vs control</FONT></TD></TR></TABLE>>];
  OUT [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#14233D" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>delivery</B></FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Grafana</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">live energy &amp; temp dashboard</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">report.ipynb</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">one per TC, committed to Git</FONT></TD></TR><TR><TD PORT="c" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">CI</FONT></TD><TD PORT="c_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">schema checks + golden cases + fw SHA exists</FONT></TD></TR></TABLE>>];
  STO:a_o:e -> PROC:a:w [color="#46556E", penwidth=1.2];
  PROC:a_o:e -> OUT:a:w [color="#46556E", penwidth=1.2];
}

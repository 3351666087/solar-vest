digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.35; ranksep=0.75;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  BOOT [label=<<TABLE BORDER="1" COLOR="#46556E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F6FA"><TR><TD COLSPAN="2" BGCOLOR="#46556E" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="7.4" COLOR="#FFFFFF"><B>BOOT</B></FONT><BR/><FONT FACE="Inter" POINT-SIZE="5.6" COLOR="#E8EEF8">self-test</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">load</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">OFF</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">ON</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">duty</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">—</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">telem</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">—</FONT></TD></TR></TABLE>>];
  CRIT [label=<<TABLE BORDER="1" COLOR="#CB4034" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCEAE8"><TR><TD COLSPAN="2" BGCOLOR="#CB4034" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="7.4" COLOR="#FFFFFF"><B>CRITICAL</B></FONT><BR/><FONT FACE="Inter" POINT-SIZE="5.6" COLOR="#E8EEF8">SoC &lt; 10%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">load</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">OFF</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">ON</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">duty</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">0%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">telem</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">60 s</FONT></TD></TR></TABLE>>];
  HARV [label=<<TABLE BORDER="1" COLOR="#B8720F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDF3E2"><TR><TD COLSPAN="2" BGCOLOR="#B8720F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="7.4" COLOR="#FFFFFF"><B>HARVEST_ONLY</B></FONT><BR/><FONT FACE="Inter" POINT-SIZE="5.6" COLOR="#E8EEF8">10–30%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">load</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">OFF</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">ON</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">duty</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">0%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">telem</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">30 s</FONT></TD></TR></TABLE>>];
  DUTY [label=<<TABLE BORDER="1" COLOR="#B8720F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFDF6"><TR><TD COLSPAN="2" BGCOLOR="#B8720F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="7.4" COLOR="#FFFFFF"><B>DUTY_CYCLE</B></FONT><BR/><FONT FACE="Inter" POINT-SIZE="5.6" COLOR="#E8EEF8">30–40%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">load</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">periodic</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">off while acq</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">duty</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">dflt 3%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">telem</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">10 s</FONT></TD></TR></TABLE>>];
  FULL [label=<<TABLE BORDER="1" COLOR="#15845F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E4F4EE"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="7.4" COLOR="#FFFFFF"><B>FULL_RATE</B></FONT><BR/><FONT FACE="Inter" POINT-SIZE="5.6" COLOR="#E8EEF8">SoC ≥ 40%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">load</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">ON</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">alternating</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">duty</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">100%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">telem</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">1 s</FONT></TD></TR></TABLE>>];
  FAULT [label=<<TABLE BORDER="1" COLOR="#CB4034" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCEAE8"><TR><TD COLSPAN="2" BGCOLOR="#CB4034" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="7.4" COLOR="#FFFFFF"><B>FAULT</B></FONT><BR/><FONT FACE="Inter" POINT-SIZE="5.6" COLOR="#E8EEF8">manual check</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">load</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">OFF</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">OFF</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">duty</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">0%</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">telem</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="6.8" COLOR="#0B1220">60 s</FONT></TD></TR></TABLE>>];
  BOOT -> CRIT [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">SoC&lt;10</FONT>>, color="#46556E", penwidth=1.0];
  BOOT -> FULL [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">SoC≥40</FONT>>, color="#46556E", penwidth=1.0];
  CRIT -> HARV [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">&gt;15%</FONT>>, color="#46556E", penwidth=1.0];
  HARV -> DUTY [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">&gt;35%</FONT>>, color="#46556E", penwidth=1.0];
  DUTY -> FULL [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">&gt;40%</FONT>>, color="#46556E", penwidth=1.0];
  FULL -> DUTY [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">&lt;35%</FONT>>, color="#46556E", penwidth=1.0];
  DUTY -> HARV [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">&lt;25%</FONT>>, color="#46556E", penwidth=1.0];
  HARV -> CRIT [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#46556E">&lt;8%</FONT>>, color="#46556E", penwidth=1.0];
  CRIT -> FAULT [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#CB4034">Vbat&lt;3.2 V or T out</FONT>>, color="#CB4034", penwidth=1.2, style=dashed];
  {rank=same; CRIT; HARV;}
  {rank=same; DUTY; FULL;}
}

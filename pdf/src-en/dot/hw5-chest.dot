digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.28; ranksep=0.6;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  subgraph cluster_chest {
    style="rounded,filled"; color="#2F6BE4"; fillcolor="#FAFBFE"; penwidth=1.0;
    label=<<FONT FACE="PingFang SC" POINT-SIZE="8" COLOR="#2F6BE4"><B>Chest unit LIB — no switching supply · no 18 V · &lt; 1 mW</B></FONT>>;
    labeljust="l"; margin=10;
  CBL2 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>J6 (chest end)</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">shield floating this end</FONT></TD></TR><TR><TD PORT="p1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">1 BAT_OUT+</FONT></TD><TD PORT="p1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">≤ 4.2 V</FONT></TD></TR><TR><TD PORT="p2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">2 GND</FONT></TD><TD PORT="p2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">—</FONT></TD></TR><TR><TD PORT="p4" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">4 CTRL_LOAD</FONT></TD><TD PORT="p4_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">switch enable</FONT></TD></TR><TR><TD PORT="p5" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">5 SYNC</FONT></TD><TD PORT="p5_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">sync pulse</FONT></TD></TR></TABLE>>];
  SC [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>supercap hold-up</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">2×2.7 V 10 F series → 5.4 V/5 F · 15.2 J · 63 s</FONT></TD></TR><TR><TD PORT="i" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">+</FONT></TD><TD PORT="i_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">BAT_OUT+</FONT></TD></TR><TR><TD PORT="m" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">MID</FONT></TD><TD PORT="m_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">bal 100 kΩ×2</FONT></TD></TR><TR><TD PORT="n" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">−</FONT></TD><TD PORT="n_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">GND</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">pre-chg</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 Ω + Q6 bypass</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">⚠</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">direct parallel = tens of A</FONT></TD></TR></TABLE>>];
  Q5 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#14233D" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>Q5 load switch + π filter</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">P-MOS AO3401</FONT></TD></TR><TR><TD PORT="g" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">G</FONT></TD><TD PORT="g_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← CTRL_LOAD</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">R1</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">100 kΩ pull-up to S</FONT></TD></TR><TR><TD PORT="s" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">S</FONT></TD><TD PORT="s_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">BAT_OUT+</FONT></TD></TR><TR><TD PORT="d" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D</FONT></TD><TD PORT="d_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ π filter</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">soft start</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">R2 10 kΩ + 100 nF ≈1 ms</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">fail-safe</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">MCU hi-Z → off</FONT></TD></TR><TR><TD PORT="o" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">π</FONT></TD><TD PORT="o_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 µH + 22 µF×2 → J7</FONT></TD></TR></TABLE>>];
  SY [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#6B4FCF" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>sync inject</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">1 kΩ + BAT54S clamp to 3V3</FONT></TD></TR><TR><TD PORT="i" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">IN</FONT></TD><TD PORT="i_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← SYNC</FONT></TD></TR><TR><TD PORT="o" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">OUT</FONT></TD><TD PORT="o_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ I1</FONT></TD></TR></TABLE>>];
  BIT [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#CB4034" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>BITalino</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">(r)evolution · ECG → A1</FONT></TD></TR><TR><TD PORT="v" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BAT +</FONT></TD><TD PORT="v_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">J7 pin1 ⚠ measure polarity first</FONT></TD></TR><TR><TD PORT="g" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BAT −</FONT></TD><TD PORT="g_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">pin2</FONT></TD></TR><TR><TD PORT="i1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">I1</FONT></TD><TD PORT="i1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 ms sync pulse ⚠ verify level</FONT></TD></TR><TR><TD PORT="gg" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">GND</FONT></TD><TD PORT="gg_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">must share gnd with PMB-H</FONT></TD></TR></TABLE>>];
  CBL2:p1_o:e -> SC:i:w [color="#2F6BE4", penwidth=1.5];
  SC:i_o:e -> Q5:s:w [color="#2F6BE4", penwidth=1.5];
  CBL2:p4_o:e -> Q5:g:w [color="#6B4FCF", penwidth=1.1, style=dashed];
  Q5:o_o:e -> BIT:v:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#2F6BE4">J7</FONT>>, color="#2F6BE4", penwidth=1.5];
  CBL2:p5_o:e -> SY:i:w [color="#6B4FCF", penwidth=1.1];
  SY:o_o:e -> BIT:i1:w [color="#6B4FCF", penwidth=1.1];
  }
}

digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.28; ranksep=0.7;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  subgraph cluster_hv {
    style="rounded,filled"; color="#B8720F"; fillcolor="#FEFBF5"; penwidth=1.0;
    label=<<FONT FACE="PingFang SC" POINT-SIZE="8" COLOR="#B8720F"><B>18 V power zone — ≥3 mm copper-free band to low-voltage zone on PCB</B></FONT>>;
    labeljust="l"; margin=10;
  PV [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#B8720F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>PV PANEL</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">30 W / 18 V</FONT></TD></TR><TR><TD PORT="p" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">PV+</FONT></TD><TD PORT="p_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">red 18AWG shielded</FONT></TD></TR><TR><TD PORT="n" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">PV−</FONT></TD><TD PORT="n_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">black</FONT></TD></TR></TABLE>>];
  PROT [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#B8720F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>PROTECTION</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">18 V zone</FONT></TD></TR><TR><TD PORT="i" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">F1</FONT></TD><TD PORT="i_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">2 A slow-blow · in panel j-box</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">TVS1</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">SMAJ26A across PV+/PV−</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D1</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">SS54 anti-reverse 40 V/5 A</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">C1</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">220 µF/35 V low ESR</FONT></TD></TR><TR><TD PORT="o" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">L1</FONT></TD><TD PORT="o_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">CM choke + ferrite</FONT></TD></TR></TABLE>>];
  RS1 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>RS1  0.02 Ω</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">1% / 2512</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">IN</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← L1</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">OUT</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ VIN</FONT></TD></TR><TR><TD PORT="k" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">K+/K−</FONT></TD><TD PORT="k_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Kelvin → INA226#1</FONT></TD></TR></TABLE>>];
  CHG [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#B8720F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>CN3791</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">MPPT 1-cell Li charger ⚠ pin nos. per datasheet</FONT></TD></TR><TR><TD PORT="vin" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VIN</FONT></TD><TD PORT="vin_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">18 V input</FONT></TD></TR><TR><TD PORT="gnd" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">GND</FONT></TD><TD PORT="gnd_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">PGND</FONT></TD></TR><TR><TD PORT="mppt" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">MPPT</FONT></TD><TD PORT="mppt_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">divider ≈0.76×Voc ≈16.5 V</FONT></TD></TR><TR><TD PORT="cs" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">CS</FONT></TD><TD PORT="cs_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Rcs → charge 1.25 A</FONT></TD></TR><TR><TD PORT="bat" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BAT</FONT></TD><TD PORT="bat_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">4.2 V CC/CV → CHG_OUT</FONT></TD></TR><TR><TD PORT="chrg" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">CHRG</FONT></TD><TD PORT="chrg_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ MCU D8</FONT></TD></TR></TABLE>>];
  PV:p_o:e -> PROT:i:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#B8720F">PV+ 18V</FONT>>, color="#B8720F", penwidth=1.6];
  PROT:o_o:e -> RS1:a:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#B8720F">VBUS18</FONT>>, color="#B8720F", penwidth=1.6];
  RS1:b_o:e -> CHG:vin:w [color="#B8720F", penwidth=1.6];
  }
}

digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.28; ranksep=0.65;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  SRC [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#B8720F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>sources  ×3</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">three independent radio links</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BITalino DUT</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">solar-powered · ECG A1 · 1000 Hz</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BITalino CTRL</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">battery-only control · same lead</FONT></TD></TR><TR><TD PORT="c" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">PMB telemetry</FONT></TD><TD PORT="c_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">power / SoC / temp / irradiance · 1 Hz</FONT></TD></TR></TABLE>>];
  COL [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>collectors</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">asyncio · back-pressure &amp; reconnect</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">bitalino_ble.py</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">bleak · GATT</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">bitalino_bt.py</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">pyserial · SPP</FONT></TD></TR><TR><TD PORT="c" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">pmb_ble.py</FONT></TD><TD PORT="c_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">custom GATT + replay dedup</FONT></TD></TR></TABLE>>];
  SYN [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#6B4FCF" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>sync  engine</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">software side of ADR-005 · error &lt;10 ms, provable</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">marker_align</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">detect I1 rising edge ↔ MCU µs stamps</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">clock_fit</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">linear fit → true rate + drift ppm</FONT></TD></TR><TR><TD PORT="c" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">residual check</FONT></TD><TD PORT="c_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">residual &gt;2 samples → flag segment</FONT></TD></TR></TABLE>>];
  SRC:a_o:e -> COL:a:w [color="#46556E", penwidth=1.2];
  COL:a_o:e -> SYN:a:w [color="#46556E", penwidth=1.2];
}

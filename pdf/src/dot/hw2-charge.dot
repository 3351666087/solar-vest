digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.28; ranksep=0.75;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  CO [label=<<TABLE BORDER="1" COLOR="#B8720F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FDF3E2"><TR><TD><FONT FACE="PingFang SC" POINT-SIZE="8.4" COLOR="#B8720F"><B>CHG_OUT</B></FONT><BR/><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">来自 CN3791.BAT<BR/>4.2 V / 1.25 A</FONT></TD></TR></TABLE>>];
  Q12 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#14233D" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>Q1 · Q2　充电切换</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">P-MOS AO3401 / SOT-23</FONT></TD></TR><TR><TD PORT="g1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q1.G</FONT></TD><TD PORT="g1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← MCU D1（经互锁）</FONT></TD></TR><TR><TD PORT="s1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q1.S</FONT></TD><TD PORT="s1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">CHG_OUT</FONT></TD></TR><TR><TD PORT="d1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q1.D</FONT></TD><TD PORT="d1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ BAT_A+</FONT></TD></TR><TR><TD PORT="g2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q2.G</FONT></TD><TD PORT="g2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← MCU D2（经互锁）</FONT></TD></TR><TR><TD PORT="s2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q2.S</FONT></TD><TD PORT="s2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">CHG_OUT</FONT></TD></TR><TR><TD PORT="d2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q2.D</FONT></TD><TD PORT="d2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ BAT_B+</FONT></TD></TR></TABLE>>];
  ILK [label=<<TABLE BORDER="1" COLOR="#CB4034" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FCEAE8"><TR><TD><FONT FACE="PingFang SC" POINT-SIZE="8.4" COLOR="#CB4034"><B>硬件互锁　反相器 + 与门</B></FONT><BR/><FONT FACE="PingFang SC" POINT-SIZE="6.6" COLOR="#8B97AB">Q1·Q2 不得同时导通<BR/>MCU 跑飞 = 电池并联 → 环流 4.2 A</FONT></TD></TR></TABLE>>];
  BA [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>BATTERY A</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">2500 mAh / 带 PCM</FONT></TD></TR><TR><TD PORT="p" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">+</FONT></TD><TD PORT="p_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">JST-PH pin1 ⚠ 极性须实测</FONT></TD></TR><TR><TD PORT="n" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">−</FONT></TD><TD PORT="n_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">pin2 → PGND</FONT></TD></TR><TR><TD PORT="t" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">NTC_A</FONT></TD><TD PORT="t_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 kΩ B3950 → MCU A0</FONT></TD></TR></TABLE>>];
  BB [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>BATTERY B</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">2500 mAh / 带 PCM</FONT></TD></TR><TR><TD PORT="p" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">+</FONT></TD><TD PORT="p_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">JST-PH pin1</FONT></TD></TR><TR><TD PORT="n" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">−</FONT></TD><TD PORT="n_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">pin2 → PGND</FONT></TD></TR><TR><TD PORT="t" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">NTC_B</FONT></TD><TD PORT="t_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 kΩ B3950 → MCU A1</FONT></TD></TR></TABLE>>];
  CO -> Q12:s1:w [color="#B8720F", penwidth=1.5];
  CO -> Q12:s2:w [color="#B8720F", penwidth=1.5];
  Q12:d1_o:e -> BA:p:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#15845F">BAT_A+</FONT>>, color="#15845F", penwidth=1.5];
  Q12:d2_o:e -> BB:p:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#15845F">BAT_B+</FONT>>, color="#15845F", penwidth=1.5];
  ILK -> Q12:g1:w [color="#CB4034", penwidth=1.0, style=dashed];
  ILK -> Q12:g2:w [color="#CB4034", penwidth=1.0, style=dashed];
}

digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.3; ranksep=0.8;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  I1 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>INA226 #1</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">PV 侧功率计量</FONT></TD></TR><TR><TD PORT="vp" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VIN+</FONT></TD><TD PORT="vp_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">RS1 开尔文 +</FONT></TD></TR><TR><TD PORT="vn" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VIN−</FONT></TD><TD PORT="vn_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">RS1 开尔文 −</FONT></TD></TR><TR><TD PORT="vb" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VBUS</FONT></TD><TD PORT="vb_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">VBUS18 分压 ⚠ 超 36 V 上限须分压</FONT></TD></TR><TR><TD PORT="vs" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VS</FONT></TD><TD PORT="vs_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">3V3</FONT></TD></TR><TR><TD PORT="g" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">GND</FONT></TD><TD PORT="g_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">AGND</FONT></TD></TR><TR><TD PORT="sc" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">SCL</FONT></TD><TD PORT="sc_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">I²C</FONT></TD></TR><TR><TD PORT="sd" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">SDA</FONT></TD><TD PORT="sd_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">I²C</FONT></TD></TR><TR><TD PORT="a0" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">A0/A1</FONT></TD><TD PORT="a0_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">GND/GND → 0x40</FONT></TD></TR></TABLE>>];
  I2 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>INA226 #2</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">电池侧双向 · 兼作库仑计</FONT></TD></TR><TR><TD PORT="vp" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VIN+</FONT></TD><TD PORT="vp_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">RS2 开尔文 +</FONT></TD></TR><TR><TD PORT="vn" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VIN−</FONT></TD><TD PORT="vn_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">RS2 开尔文 −</FONT></TD></TR><TR><TD PORT="vb" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VBUS</FONT></TD><TD PORT="vb_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">LOAD_BUS 直接</FONT></TD></TR><TR><TD PORT="vs" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">VS</FONT></TD><TD PORT="vs_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">3V3</FONT></TD></TR><TR><TD PORT="g" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">GND</FONT></TD><TD PORT="g_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">AGND</FONT></TD></TR><TR><TD PORT="sc" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">SCL</FONT></TD><TD PORT="sc_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">I²C</FONT></TD></TR><TR><TD PORT="sd" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">SDA</FONT></TD><TD PORT="sd_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">I²C</FONT></TD></TR><TR><TD PORT="a0" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">A0/A1</FONT></TD><TD PORT="a0_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">VS/GND → 0x41</FONT></TD></TR></TABLE>>];
  NTC [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>NTC 分压 ×2</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">0 °C &lt; T &lt; 45 °C 方可充电</FONT></TD></TR><TR><TD PORT="o1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">A0_IN</FONT></TD><TD PORT="o1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 kΩ ÷ NTC_A</FONT></TD></TR><TR><TD PORT="o2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">A1_IN</FONT></TD><TD PORT="o2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">10 kΩ ÷ NTC_B</FONT></TD></TR></TABLE>>];
  MCU [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#6B4FCF" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>XIAO nRF52840</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">BLE 遥测 · 能量状态机 · 库仑积分</FONT></TD></TR><TR><TD PORT="sda" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D4 / SDA</FONT></TD><TD PORT="sda_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">I²C 数据 ⚠ 核实默认映射</FONT></TD></TR><TR><TD PORT="scl" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D5 / SCL</FONT></TD><TD PORT="scl_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">I²C 时钟</FONT></TD></TR><TR><TD PORT="a0" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D0 / A0</FONT></TD><TD PORT="a0_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">NTC_A</FONT></TD></TR><TR><TD PORT="a1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D1x / A1</FONT></TD><TD PORT="a1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">NTC_B</FONT></TD></TR><TR><TD PORT="q1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D1</FONT></TD><TD PORT="q1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Q1 栅极（充电 A）</FONT></TD></TR><TR><TD PORT="q2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D2</FONT></TD><TD PORT="q2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Q2 栅极（充电 B）</FONT></TD></TR><TR><TD PORT="q3" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D3</FONT></TD><TD PORT="q3_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Q3 栅极（放电 A）</FONT></TD></TR><TR><TD PORT="q4" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D6</FONT></TD><TD PORT="q4_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">Q4 栅极（放电 B）</FONT></TD></TR><TR><TD PORT="ld" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D7</FONT></TD><TD PORT="ld_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">CTRL_LOAD → J6.4</FONT></TD></TR><TR><TD PORT="ch" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D8</FONT></TD><TD PORT="ch_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">CN3791 CHRG 读取</FONT></TD></TR><TR><TD PORT="sy" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">D10</FONT></TD><TD PORT="sy_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">SYNC 脉冲 → J6.5</FONT></TD></TR><TR><TD PORT="p" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">3V3 / GND</FONT></TD><TD PORT="p_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">板载 LDO · 星型地</FONT></TD></TR></TABLE>>];
  I1:sc:e -> MCU:scl:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#2F6BE4">SCL</FONT>>, color="#2F6BE4", penwidth=1.1];
  I1:sd:e -> MCU:sda:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#2F6BE4">SDA</FONT>>, color="#2F6BE4", penwidth=1.1];
  I2:sc:e -> MCU:scl:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#2F6BE4">SCL</FONT>>, color="#2F6BE4", penwidth=1.1];
  I2:sd:e -> MCU:sda:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#2F6BE4">SDA</FONT>>, color="#2F6BE4", penwidth=1.1];
  NTC:o1_o:e -> MCU:a0:w [color="#15845F", penwidth=1.1];
  NTC:o2_o:e -> MCU:a1:w [color="#15845F", penwidth=1.1];
}

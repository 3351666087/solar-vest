digraph G {
  bgcolor="transparent";
  rankdir=LR; splines=spline; nodesep=0.28; ranksep=0.7;
  node [shape=plaintext, fontname="PingFang SC", fontsize=8];
  edge [fontname="Menlo", fontsize=6.5, color="#46556E", penwidth=1.0, arrowsize=0.55];
  BAT2 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#15845F" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>BATTERY A / B</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">任一时刻仅一块放电</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BAT_A+</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ Q3.S</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">BAT_B+</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ Q4.S</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">PGND</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">星型地单点</FONT></TD></TR></TABLE>>];
  Q34 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#14233D" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>Q3 · Q4　放电切换</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">背靠背双 FET 或 LM66100</FONT></TD></TR><TR><TD PORT="g3" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q3.G</FONT></TD><TD PORT="g3_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← MCU D3</FONT></TD></TR><TR><TD PORT="s3" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q3.S</FONT></TD><TD PORT="s3_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">BAT_A+</FONT></TD></TR><TR><TD PORT="d3" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q3.D</FONT></TD><TD PORT="d3_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ LOAD_BUS</FONT></TD></TR><TR><TD PORT="g4" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q4.G</FONT></TD><TD PORT="g4_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← MCU D6</FONT></TD></TR><TR><TD PORT="s4" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q4.S</FONT></TD><TD PORT="s4_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">BAT_B+</FONT></TD></TR><TR><TD PORT="d4" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">Q4.D</FONT></TD><TD PORT="d4_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ LOAD_BUS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">⚠ 体二极管</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">须反向阻断</FONT></TD></TR></TABLE>>];
  RS2 [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>RS2  0.02 Ω</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">1% / 2512 · 库仑计</FONT></TD></TR><TR><TD PORT="a" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">IN</FONT></TD><TD PORT="a_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">LOAD_BUS</FONT></TD></TR><TR><TD PORT="b" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">OUT</FONT></TD><TD PORT="b_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ J6.1</FONT></TD></TR><TR><TD PORT="k" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">K+/K−</FONT></TD><TD PORT="k_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">→ INA226#2 双向</FONT></TD></TR></TABLE>>];
  CBL [label=<<TABLE BORDER="1" COLOR="#CBD4E3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" BGCOLOR="#2F6BE4" ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="8.6" COLOR="#FFFFFF"><B>J6　CABLE</B></FONT><BR/><FONT POINT-SIZE="6.4" COLOR="#C8D3E6">5 芯屏蔽 · 磁吸防拉脱</FONT></TD></TR><TR><TD PORT="p1" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">1  BAT_OUT+</FONT></TD><TD PORT="p1_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">≤ 4.2 V 供电</FONT></TD></TR><TR><TD PORT="p2" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">2  GND</FONT></TD><TD PORT="p2_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">功率地回流</FONT></TD></TR><TR><TD PORT="p3" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">3  GND</FONT></TD><TD PORT="p3_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">信号地</FONT></TD></TR><TR><TD PORT="p4" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">4  CTRL_LOAD</FONT></TD><TD PORT="p4_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← MCU D7</FONT></TD></TR><TR><TD PORT="p5" ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">5  SYNC</FONT></TD><TD PORT="p5_o" ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">← MCU D10</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT FACE="Menlo" POINT-SIZE="7.2" COLOR="#0B1220">SHIELD</FONT></TD><TD ALIGN="LEFT"><FONT FACE="PingFang SC" POINT-SIZE="7" COLOR="#46556E">仅 PMB-H 端接地</FONT></TD></TR></TABLE>>];
  BAT2:a_o:e -> Q34:s3:w [color="#2F6BE4", penwidth=1.5];
  BAT2:b_o:e -> Q34:s4:w [color="#2F6BE4", penwidth=1.5];
  Q34:d3_o:e -> RS2:a:w [label=<<FONT FACE="Menlo" POINT-SIZE="6.4" COLOR="#2F6BE4">LOAD_BUS</FONT>>, color="#2F6BE4", penwidth=1.5];
  Q34:d4_o:e -> RS2:a:w [color="#2F6BE4", penwidth=1.5];
  RS2:b_o:e -> CBL:p1:w [color="#2F6BE4", penwidth=1.5];
}

(version 1)
# JLCPCB 8-layer plan B (v3/planb, through vias only); 6-layer deck values, as read on jlcpcb.com/capabilities/pcb-capabilities (cache/v2/jlc_cap, 2026-11-12) + v3/design/netclasses.json
(rule "WLCSP / DSBGA fan-out: 0.09 / 0.09 inside the package courtyards only"
  (condition "A.intersectsCourtyard('U6') || B.intersectsCourtyard('U6') || A.intersectsCourtyard('U8') || B.intersectsCourtyard('U8') || A.intersectsCourtyard('U4') || B.intersectsCourtyard('U4') || A.intersectsCourtyard('U5') || B.intersectsCourtyard('U5')")
  (constraint clearance (min 0.09mm)) (constraint track_width (min 0.09mm)))
(rule "JLC via 0.15 / 0.25 minimum"
  (condition "A.Type == 'Via'") (constraint hole_size (min 0.15mm)) (constraint via_diameter (min 0.25mm)) (constraint annular_width (min 0.05mm)))
(rule "JLC via hole to track / inner-layer hole to copper 0.20"
  (constraint hole_clearance (min 0.2mm)))
(rule "JLC hole to hole 0.20"
  (constraint hole_to_hole (min 0.2mm)))
# [layout] LEAD_NOTES 2e R-2: PWR_HIGH, VDD_1V8 and ECG-band nets: no via over a plate, no inner-layer track over a plate
(rule "R-2 no via of a forbidden net over a plate"
  (condition "A.Type == 'Via' && (A.intersectsArea('PLATE_E1_AREA') || A.intersectsArea('PLATE_E2_AREA')) && (A.NetName == 'ALERT_A' || A.NetName == 'ALERT_K' || A.NetName == 'ALERT_LED' || A.NetName == 'AVDD_EN' || A.NetName == 'BATT_P' || A.NetName == 'BATT_P_A' || A.NetName == 'BQ_EN' || A.NetName == 'BTN' || A.NetName == 'BTN_G' || A.NetName == 'BTN_N' || A.NetName == 'BTN_SUP' || A.NetName == 'CHG_DIS' || A.NetName == 'DISP_CTRL' || A.NetName == 'DISP_EN' || A.NetName == 'D_DISP' || A.NetName == 'D_EXTCOMIN' || A.NetName == 'ECG_PWR_EN' || A.NetName == 'EN_HOLD' || A.NetName == 'EXTCOMIN' || A.NetName == 'FL_A' || A.NetName == 'FL_EN' || A.NetName == 'FL_K' || A.NetName == 'I2C_SCL' || A.NetName == 'I2C_SDA' || A.NetName == 'INA_EN' || A.NetName == 'LBOOST' || A.NetName == 'LBUCK' || A.NetName == 'LED1_DRV' || A.NetName == 'LED2_DRV' || A.NetName == 'MOTOR_G' || A.NetName == 'MOTOR_N' || A.NetName == 'MOTOR_PWM' || A.NetName == 'MOTOR_S' || A.NetName == 'NTC' || A.NetName == 'NTC_ADC' || A.NetName == 'NTC_EN' || A.NetName == 'O2_HB' || A.NetName == 'O2_TC' || A.NetName == 'O2_TH' || A.NetName == 'PV_INH' || A.NetName == 'PV_NODE' || A.NetName == 'PV_Q' || A.NetName == 'PV_SW' || A.NetName == 'PV_W' || A.NetName == 'PWR_CYC' || A.NetName == 'PWR_HOLD' || A.NetName == 'SW_ON' || A.NetName == 'VBAT_IC' || A.NetName == 'VBUS' || A.NetName == 'VBUS_K' || A.NetName == 'VDD_1V8' || A.NetName == 'VIN_DC' || A.NetName == 'VLED' || A.NetName == 'VOUT_EN' || A.NetName == 'VSTOR' || A.NetName == 'VSTOR_SW')")
  (constraint disallow via))
(rule "R-2 no inner track of a forbidden net over a plate"
  (layer inner)
  (condition "A.Type == 'Track' && A.Layer != 'In2.Cu' && A.Layer != 'In3.Cu' && (A.intersectsArea('PLATE_E1_AREA') || A.intersectsArea('PLATE_E2_AREA')) && (A.NetName == 'ALERT_A' || A.NetName == 'ALERT_K' || A.NetName == 'ALERT_LED' || A.NetName == 'AVDD_EN' || A.NetName == 'BATT_P' || A.NetName == 'BATT_P_A' || A.NetName == 'BQ_EN' || A.NetName == 'BTN' || A.NetName == 'BTN_G' || A.NetName == 'BTN_N' || A.NetName == 'BTN_SUP' || A.NetName == 'CHG_DIS' || A.NetName == 'DISP_CTRL' || A.NetName == 'DISP_EN' || A.NetName == 'D_DISP' || A.NetName == 'D_EXTCOMIN' || A.NetName == 'ECG_PWR_EN' || A.NetName == 'EN_HOLD' || A.NetName == 'EXTCOMIN' || A.NetName == 'FL_A' || A.NetName == 'FL_EN' || A.NetName == 'FL_K' || A.NetName == 'I2C_SCL' || A.NetName == 'I2C_SDA' || A.NetName == 'INA_EN' || A.NetName == 'LBOOST' || A.NetName == 'LBUCK' || A.NetName == 'LED1_DRV' || A.NetName == 'LED2_DRV' || A.NetName == 'MOTOR_G' || A.NetName == 'MOTOR_N' || A.NetName == 'MOTOR_PWM' || A.NetName == 'MOTOR_S' || A.NetName == 'NTC' || A.NetName == 'NTC_ADC' || A.NetName == 'NTC_EN' || A.NetName == 'O2_HB' || A.NetName == 'O2_TC' || A.NetName == 'O2_TH' || A.NetName == 'PV_INH' || A.NetName == 'PV_NODE' || A.NetName == 'PV_Q' || A.NetName == 'PV_SW' || A.NetName == 'PV_W' || A.NetName == 'PWR_CYC' || A.NetName == 'PWR_HOLD' || A.NetName == 'SW_ON' || A.NetName == 'VBAT_IC' || A.NetName == 'VBUS' || A.NetName == 'VBUS_K' || A.NetName == 'VDD_1V8' || A.NetName == 'VIN_DC' || A.NetName == 'VLED' || A.NetName == 'VOUT_EN' || A.NetName == 'VSTOR' || A.NetName == 'VSTOR_SW')")
  (constraint disallow track))
(rule "T-5 U10 island: no via of another net"
  (condition "A.Type == 'Via' && A.NetName != 'TMP117_ISLAND' && A.intersectsArea('U10_ISLAND_AREA')")
  (constraint disallow via))
(rule "S2d J40 sits on the AE1 spring land (LEAD_NOTES 2i L-1)"
  (condition "(A.Reference == 'J40' && B.Reference == 'AE1') || (A.Reference == 'AE1' && B.Reference == 'J40')")
  (constraint courtyard_clearance (min -10mm)))

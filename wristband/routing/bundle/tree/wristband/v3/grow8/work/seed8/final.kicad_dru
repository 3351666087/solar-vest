# [grow8 Q-2] neck-down at pads (LEAD_NOTES 2p): 0.09 / 0.09 mm within 1.5 mm of an own pad (areas NECK_k_AREA)
(rule "Q-2 neck clearance"
  (condition "A.Type == 'Track' && A.Width < 0.095mm && ((A.NetName == 'ALERT_A' && A.enclosedByArea('NECK_0_AREA')) || (A.NetName == 'ALERT_K' && A.enclosedByArea('NECK_1_AREA')) || (A.NetName == 'ALERT_LED' && A.enclosedByArea('NECK_2_AREA')) || (A.NetName == 'ANT_FEED' && A.enclosedByArea('NECK_3_AREA')) || (A.NetName == 'AVDD_ECG' && A.enclosedByArea('NECK_4_AREA')) || (A.NetName == 'AVDD_EN' && A.enclosedByArea('NECK_5_AREA')) || (A.NetName == 'BATT_P' && A.enclosedByArea('NECK_6_AREA')) || (A.NetName == 'BATT_P_A' && A.enclosedByArea('NECK_7_AREA')) || (A.NetName == 'BQ_EN' && A.enclosedByArea('NECK_8_AREA')) || (A.NetName == 'BTN' && A.enclosedByArea('NECK_9_AREA')) || (A.NetName == 'BTN_G' && A.enclosedByArea('NECK_10_AREA')) || (A.NetName == 'BTN_N' && A.enclosedByArea('NECK_11_AREA')) || (A.NetName == 'BTN_SUP' && A.enclosedByArea('NECK_12_AREA')) || (A.NetName == 'CHG_DIS' && A.enclosedByArea('NECK_13_AREA')) || (A.NetName == 'CHG_PG_N' && A.enclosedByArea('NECK_14_AREA')) || (A.NetName == 'CS_ECG' && A.enclosedByArea('NECK_15_AREA')) || (A.NetName == 'CS_FLASH' && A.enclosedByArea('NECK_16_AREA')) || (A.NetName == 'CS_PPG' && A.enclosedByArea('NECK_17_AREA')) || (A.NetName == 'CYC_A' && A.enclosedByArea('NECK_18_AREA')) || (A.NetName == 'CYC_G' && A.enclosedByArea('NECK_19_AREA')) || (A.NetName == 'DCC' && A.enclosedByArea('NECK_20_AREA')) || (A.NetName == 'DCDC_MID' && A.enclosedByArea('NECK_21_AREA')) || (A.NetName == 'DEC1' && A.enclosedByArea('NECK_22_AREA')) || (A.NetName == 'DEC2' && A.enclosedByArea('NECK_23_AREA')) || (A.NetName == 'DEC3' && A.enclosedByArea('NECK_24_AREA')) || (A.NetName == 'DEC4' && A.enclosedByArea('NECK_25_AREA')) || (A.NetName == 'DISP_CTRL' && A.enclosedByArea('NECK_26_AREA')) || (A.NetName == 'DISP_EN' && A.enclosedByArea('NECK_27_AREA')) || (A.NetName == 'DISP_SCS' && A.enclosedByArea('NECK_28_AREA')) || (A.NetName == 'D_DISP' && A.enclosedByArea('NECK_29_AREA')) || (A.NetName == 'D_EXTCOMIN' && A.enclosedByArea('NECK_30_